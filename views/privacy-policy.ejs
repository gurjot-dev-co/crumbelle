<%- include("partials/header.ejs") %>

<main class="minor-page privacy-page">

    <div class="minor-page-container">

        <div class="minor-page-header">
            <span class="minor-page-eyebrow">PRIVACY POLICY</span>
            <h1 class="minor-page-title">
                Your information,<br>
                handled with care.
            </h1>
            <p class="minor-page-intro">We respect your privacy and want you to understand what information Crumbelle collects, 
                why we use it, and how you can manage it.
            </p>
        </div>

        <!-- intro  -->
        <section class="minor-page-section privacy-intro">
            <div class="privacy-intro-content">
                <span class="minor-page-section-label">OUR COMMITMENT</span>
                <h2 class="minor-page-section-title">Privacy should be easy to understand.</h2>
                <p>This Privacy Policy explains how Crumbelle may collect, use, store, and handle personal information when you visit
                    our website, create an account, place an order, or contact us.
                </p>
                <p>By using our website, you acknowledge the practices described in this policy.</p>
                <span class="privacy-updated">Last updated: <%= new Date().toLocaleString('en-IN', { month: 'long', year: 'numeric' }) %></span>
            </div>
        </section>

        <!-- info we collect  -->
        <section class="minor-page-section privacy-section">

            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">INFORMATION WE COLLECT</span>
                <h2 class="minor-page-section-title">What information may we receive?</h2>
            </div>

            <div class="privacy-list">

                <div class="privacy-item">
                    <span class="privacy-item-number">01</span>
                    <div class="privacy-item-content">
                        <h3>Account information</h3>
                        <p>When you create an account, we may collect information such as your name, email address, phone number, and
                            account credentials.
                        </p>
                    </div>
                </div>

                <div class="privacy-item">
                    <span class="privacy-item-number">02</span>
                    <div class="privacy-item-content">
                        <h3>Order information</h3>
                        <p>When you place an order, we may collect information needed to process it, including your selected products,
                            quantities, order number, delivery details, and order history.
                        </p>
                    </div>
                </div>

                <div class="privacy-item">
                    <span class="privacy-item-number">03</span>
                    <div class="privacy-item-content">
                        <h3>Payment information</h3>
                        <p>Depending on the payment method you choose, payment information may be processed through the payment
                            service used during checkout. We do not ask you to provide full payment credentials to us outside the
                            applicable payment process.
                        </p>
                    </div>
                </div>

                <div class="privacy-item">
                    <span class="privacy-item-number">04</span>
                    <div class="privacy-item-content">
                        <h3>Communication information</h3>
                        <p>If you contact us, we may receive the information you choose to provide, such as your name, contact
                            details, order number, and the contents of your message.
                        </p>
                    </div>
                </div>

                <div class="privacy-item">
                    <span class="privacy-item-number">05</span>
                    <div class="privacy-item-content">
                        <h3>Website information</h3>
                        <p>We may receive technical information associated with your visit, such as browser, device, and usage
                            information, where this is necessary for operating, securing, and improving the website.
                        </p>
                    </div>
                </div>

            </div>

        </section>

        <!-- how we use info  -->
        <section class="minor-page-section privacy-section">

            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">HOW WE USE INFORMATION</span>
                <h2 class="minor-page-section-title">Why do we use your information?</h2>
            </div>

            <div class="privacy-use-grid">

                <div class="privacy-use-card">
                    <span class="privacy-use-number">01</span>
                    <h3>Manage your account</h3>
                    <p>To create, maintain, and secure your Crumbelle account.</p>
                </div>

                <div class="privacy-use-card">
                    <span class="privacy-use-number">02</span>
                    <h3>Process orders</h3>
                    <p>To process purchases, prepare orders, arrange delivery, and provide order-related support.</p>
                </div>

                <div class="privacy-use-card">
                    <span class="privacy-use-number">03</span>
                    <h3>Provide support</h3>
                    <p>To respond to questions, complaints, and requests relating to your account or orders.</p>
                </div>

                <div class="privacy-use-card">
                    <span class="privacy-use-number">04</span>
                    <h3>Improve Crumbelle</h3>
                    <p>To understand how the website is used and improve its functionality, security, and customer experience.</p>
                </div>

                <div class="privacy-use-card">
                    <span class="privacy-use-number">05</span>
                    <h3>Maintain security</h3>
                    <p>To detect, prevent, and investigate fraud, misuse, unauthorized access, and other security issues.</p>
                </div>

                <div class="privacy-use-card">
                    <span class="privacy-use-number">06</span>
                    <h3>Meet legal obligations</h3>
                    <p>Where necessary, to comply with applicable legal, regulatory, accounting, or other lawful requirements.</p>
                </div>

            </div>

        </section>


        <section class="minor-page-section privacy-section">
            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">ACCOUNTS & ORDERS</span>
                <h2 class="minor-page-section-title">Information connected to your purchases.</h2>
            </div>
            <div class="privacy-text-block">
                <h3>Your account</h3>
                <p>If you create an account with Crumbelle, information associated with that account may be used to provide
                    features such as login, cart management, order history, and account-related services.
                </p>
                <h3>Your orders</h3>
                <p>Information connected to an order may be retained as necessary to process the transaction, provide customer
                    support, maintain accurate records, and meet applicable legal obligations.
                </p>
            </div>
        </section>


        <section class="minor-page-section privacy-section">
            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">INFORMATION SHARING</span>
                <h2 class="minor-page-section-title">When may information be shared?</h2>
            </div>
            <div class="privacy-text-block">
                <p>We may share personal information with service providers where doing so is necessary to operate Crumbelle or provide
                    services you request.
                </p>
                <p>This may include providers involved in payment processing, website infrastructure, delivery, security, communications,
                    or other technical services used by the website.
                </p>
                <p>We may also disclose information where required to comply with applicable law, legal process, or a lawful request
                    from an authorized authority.
                </p>
                <p>We do not treat your personal information as something to be sold as a standalone product.</p>
            </div>
        </section>


        <section class="minor-page-section privacy-section">
            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">COOKIES & TECHNOLOGIES</span>
                <h2 class="minor-page-section-title">How the website remembers things.</h2>
            </div>
            <div class="privacy-text-block">
                <p>Crumbelle may use cookies, local storage, sessions, or similar technologies where necessary to keep the website
                    functioning, remember relevant preferences, maintain authenticated sessions, and support website security.
                </p>
                <p>Some technologies may also be used to understand website usage or improve the experience, depending on the services
                    enabled on the website.
                </p>
                <p>You can control certain cookies through your browser settings. Disabling some technologies may affect parts
                    of the website.
                </p>
            </div>
        </section>


        <section class="minor-page-section privacy-section">
            <div class="privacy-highlight">
                <span class="minor-page-section-label">DATA SECURITY</span>
                <h2 class="minor-page-section-title">We take reasonable steps to protect your information.</h2>
                <p>Crumbelle uses reasonable technical and organizational measures intended to protect personal information against
                    unauthorized access, misuse, loss, alteration, or disclosure.
                </p>
                <p>However, no method of storing or transmitting information over the internet can be guaranteed to be completely secure.</p>
            </div>
        </section>


        <section class="minor-page-section privacy-section">
            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">DATA RETENTION</span>
                <h2 class="minor-page-section-title">How long do we keep information?</h2>
            </div>
            <div class="privacy-text-block">
                <p>We retain personal information for as long as reasonably necessary for the purposes described in this policy,
                    including providing services, maintaining records, resolving disputes, preventing misuse, and meeting applicable 
                    legal or regulatory requirements.
                </p>
                <p>When information is no longer reasonably required for these purposes, it may be deleted, anonymized, or otherwise
                    handled in accordance with applicable requirements.
                </p>
            </div>
        </section>


        <section class="minor-page-section privacy-section">

            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">YOUR CHOICES</span>
                <h2 class="minor-page-section-title">You have a say in your information.</h2>
            </div>

            <div class="privacy-choice-list">

                <div class="privacy-choice-item">
                    <span class="privacy-choice-number">01</span>
                    <div>
                        <h3>Review your information</h3>
                        <p>You may contact us to ask about personal information associated with you, subject to applicable law.</p>
                    </div>
                </div>

                <div class="privacy-choice-item">
                    <span class="privacy-choice-number">02</span>
                    <div>
                        <h3>Request correction</h3>
                        <p>If information associated with you is inaccurate or incomplete, you may ask us to correct it, subject
                            to applicable requirements.
                        </p>
                    </div>
                </div>

                <div class="privacy-choice-item">
                    <span class="privacy-choice-number">03</span>
                    <div>
                        <h3>Request deletion</h3>
                        <p>You may request deletion of personal information where applicable, subject to information that we may need to 
                            retain under law or for legitimate business purposes.
                        </p>
                    </div>
                </div>


                <div class="privacy-choice-item">
                    <span class="privacy-choice-number">04</span>
                    <div>
                        <h3>Raise a privacy concern</h3>
                        <p>You may contact us regarding questions, concerns, or requests relating to the handling of your personal information.</p>
                    </div>
                </div>

            </div>

        </section>


        <section class="minor-page-section privacy-section">
            <div class="privacy-text-block">
                <span class="minor-page-section-label">AGE & CHILDREN</span>
                <h2 class="minor-page-section-title">Using Crumbelle responsibly.
                </h2>
                <p>Crumbelle is intended for general customers and is not specifically directed at children. We do not knowingly
                    seek to collect personal information from children in circumstances where applicable law requires parental
                    consent or other safeguards.
                </p>
            </div>
        </section>


        <section class="minor-page-section privacy-section">
            <div class="privacy-text-block">
                <span class="minor-page-section-label">POLICY UPDATES</span>
                <h2 class="minor-page-section-title">This policy may change over time.</h2>
                <p>We may update this Privacy Policy when our website, services, data practices, or applicable requirements change.
                    Any updated version will be posted on this page with a revised "Last updated" date.
                </p>
            </div>
        </section>

        <!-- contact  -->
        <section class="minor-page-closing privacy-closing">
            <span class="minor-page-closing-eyebrow">PRIVACY QUESTIONS?</span>
            <h2>We're here to help.</h2>
            <p>If you have a question, concern, or request regarding your personal information, please get in touch with us</p>
            <a href="/contact" class="minor-page-primary-button">
                Contact Us
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </section>

    </div>

</main>

<%- include("partials/footer.ejs") %>