<%- include("partials/header.ejs") %>

<main class="minor-page returns-page">

    <div class="minor-page-container">

        <div class="minor-page-header">
            <span class="minor-page-eyebrow">RETURNS & REFUNDS</span>
            <h1 class="minor-page-title">
                When something<br>
                isn't quite right.
            </h1>
            <p class="minor-page-intro">We want every Crumbelle order to arrive just as it should. Here's what to do if your order is 
                damaged, incorrect, or there is an issue that needs our attention.
            </p>
        </div>


        <section class="minor-page-section returns-note">
            <div class="returns-note-content">
                <span class="minor-page-section-label">PLEASE NOTE</span>
                <h2 class="minor-page-section-title">Bakery products are different from ordinary goods.</h2>
                <p>Because our products are prepared for consumption and many are best enjoyed fresh, we generally cannot accept
                    ordinary returns simply because you have changed your mind. Issues involving damaged, incorrect, or unsuitable orders
                    should be reported to us as soon as possible.
                </p>
            </div>
        </section>

        <!-- when to contact  -->
        <section class="minor-page-section returns-cases">

            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">ELIGIBILITY</span>
                <h2 class="minor-page-section-title">Who is eligible for return and refund?</h2>
            </div>

            <div class="returns-cases-grid">
                <div class="returns-case">
                    <span class="returns-case-number">01</span>
                    <h3>Damaged order</h3>
                    <p>Your order arrives damaged or in a condition that appears to have been affected during handling or delivery.</p>
                </div>

                <div class="returns-case">
                    <span class="returns-case-number">02</span>
                    <h3>Incorrect order</h3>
                    <p>You received a product that you did not order or an item is missing from your order.</p>
                </div>

                <!-- <div class="returns-case">
                    <span class="returns-case-number">03</span>
                    <h3>Order issue</h3>
                    <p>There is another significant issue with your order that requires our team to review it.</p>
                </div> -->

            </div>

        </section>

        <!-- what to do  -->
        <section class="minor-page-section returns-process">

            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">WHAT TO DO</span>
                <h2 class="minor-page-section-title">We've made the process simple.</h2>
            </div>

            <div class="returns-process-list">

                <div class="returns-process-item">
                    <span class="returns-process-number">01</span>
                    <div class="returns-process-content">
                        <h3>Contact us promptly</h3>
                        <p>Get in touch with us as soon as possible after receiving your order and explain the issue clearly.</p>
                    </div>
                </div>

                <div class="returns-process-item">
                    <span class="returns-process-number">02</span>
                    <div class="returns-process-content">
                        <h3>Share your order details</h3>
                        <p>Provide your order number along with the details of what went wrong so that we can identify your order.</p>
                    </div>
                </div>

                <div class="returns-process-item">
                    <span class="returns-process-number">03</span>
                    <div class="returns-process-content">
                        <h3>Provide photographs when requested</h3>
                        <p>For damaged or incorrect orders, we may ask for photographs or other information to help us review the issue.</p>
                    </div>
                </div>

                <div class="returns-process-item">
                    <span class="returns-process-number">04</span>
                    <div class="returns-process-content">
                        <h3>We'll review the issue</h3>
                        <p>Our team will review the details you provide and let you know what resolution is available for your particular situation.</p>
                    </div>
                </div>

            </div>

        </section>

        <!-- refunds  -->
        <section class="minor-page-section refunds-section">

            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">REFUNDS</span>
                <h2 class="minor-page-section-title">How refunds work</h2>
            </div>

            <div class="refunds-list">

                <div class="refund-item">
                    <h3>Refund approval</h3>
                    <p>If a refund is approved after reviewing your issue, we will confirm the applicable amount and refund process with you.</p>
                </div>

                <div class="refund-item">
                    <h3>Payment method</h3>
                    <p>The money will be sent back to the exact same card or account you used to pay for the order.</p>
                </div>

                <div class="refund-item">
                    <h3>Refund timing</h3>
                    <p>Once a refund is approved, we will process it from our side within one week.
                    </p>
                </div>

            </div>

        </section>


        <section class="minor-page-closing returns-closing">
            <span class="minor-page-closing-eyebrow">NEED HELP?</span>
            <h2>Something went wrong with your order?</h2>
            <p>Tell us what happened and our team will help you understand what can be done.</p>
            <a href="/contact" class="minor-page-primary-button">
                Contact Us
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </section>

    </div>

</main>

<%- include("partials/footer.ejs") %>