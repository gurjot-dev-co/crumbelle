<%- include("partials/header.ejs") %>

<main class="minor-page shipping-page">

    <div class="minor-page-container">

        <div class="minor-page-header">
            <span class="minor-page-eyebrow">SHIPPING & DELIVERY</span>
            <h1 class="minor-page-title">
                Freshly baked,<br>
                carefully delivered.
            </h1>
            <p class="minor-page-intro">From our kitchen to your doorstep, we take care to make sure every order reaches you fresh, 
                secure, and ready to enjoy.
            </p>
        </div>

        <!-- delivery overview  -->
        <section class="minor-page-section shipping-overview">

            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">AT A GLANCE</span>
                <h2 class="minor-page-section-title">Delivery made simple</h2>
            </div>

            <div class="shipping-overview-grid">

                <div class="shipping-overview-card">
                    <span class="shipping-overview-number">01</span>
                    <h3>Delivery Charge</h3>
                    <p>A flat delivery charge of ₹50 applies to orders containing items.</p>
                </div>

                <div class="shipping-overview-card">
                    <span class="shipping-overview-number">02</span>
                    <h3>Fresh Preparation</h3>
                    <p>Your order is prepared and packed with care before it leaves our bakery.</p>
                </div>

                <div class="shipping-overview-card">
                    <span class="shipping-overview-number">03</span>
                    <h3>Careful Delivery</h3>
                    <p>Your bakes are handled carefully throughout their journey to you.</p>
                </div>

            </div>

        </section>

        <!-- delivery process  -->
        <section class="minor-page-section shipping-process">

            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">OUR PROCESS</span>
                <h2 class="minor-page-section-title">From our oven to your door</h2>
            </div>

            <div class="shipping-process-list">

                <div class="shipping-process-item">
                    <span class="shipping-process-number">01</span>
                    <div class="shipping-process-content">
                        <h3>Order placed</h3>
                        <p>Once your order is successfully placed, we begin preparing it according to the items you've chosen.</p>
                    </div>
                </div>

                <div class="shipping-process-item">
                    <span class="shipping-process-number">02</span>
                    <div class="shipping-process-content">
                        <h3>Freshly prepared</h3>
                        <p>Our team prepares your selected bakes with care, keeping freshness at the centre of the process.</p>
                    </div>
                </div>

                <div class="shipping-process-item">
                    <span class="shipping-process-number">03</span>
                    <div class="shipping-process-content">
                        <h3>Carefully packed</h3>
                        <p>Your order is packed securely so that it can travel safely while maintaining its presentation and quality.</p>
                    </div>
                </div>

                <div class="shipping-process-item">
                    <span class="shipping-process-number">04</span>
                    <div class="shipping-process-content">
                        <h3>Out for delivery</h3>
                        <p>Once your order leaves our bakery, it begins its journey to the delivery address provided at checkout.</p>
                    </div>
                </div>

                <div class="shipping-process-item">
                    <span class="shipping-process-number">05</span>
                    <div class="shipping-process-content">
                        <h3>Delivered to you</h3>
                        <p>Your order arrives at your doorstep, ready to be enjoyed.</p>
                    </div>
                </div>

            </div>

        </section>

        <!-- delivery info  -->
        <section class="minor-page-section shipping-information">

            <div class="minor-page-section-heading">
                <span class="minor-page-section-label">DELIVERY INFORMATION</span>
                <h2 class="minor-page-section-title">A few things to know</h2>
            </div>

            <div class="shipping-information-list">

                <div class="shipping-information-item">
                    <h3>Where do you deliver?</h3>
                    <p>Delivery availability depends on the location entered during checkout. Available delivery options will be shown 
                        before your order is placed.
                    </p>
                </div>

                <div class="shipping-information-item">
                    <h3>How long will my order take?</h3>
                    <p>Delivery time may vary depending on your location, the products in your order, and the preparation schedule. 
                        Please check the delivery information shown during checkout for the applicable details.
                    </p>
                </div>

                <div class="shipping-information-item">
                    <h3>When does preparation begin?</h3>
                    <p>Preparation begins after your order has been successfully placed. Some products may require additional preparation time.</p>
                </div>

                <div class="shipping-information-item">
                    <h3>What if I'm unavailable?</h3>
                    <p>Please make sure someone is available to receive the order at the delivery address provided during checkout.</p>
                </div>

                <div class="shipping-information-item">
                    <h3>Can I change my delivery details?</h3>
                    <p>Please contact us as soon as possible if you notice an issue with your delivery information. Changes may not
                        always be possible once preparation or delivery has begun.
                    </p>
                </div>

                <div class="shipping-information-item">
                    <h3>What if my order is delayed?</h3>
                    <p>If your order is taking longer than expected, please contact us with your order number and we'll help you
                        check its current status.
                    </p>
                </div>

            </div>

        </section>

        <!-- delivery care  -->
        <section class="minor-page-section shipping-care">
            <div class="shipping-care-content">
                <span class="minor-page-section-label">A LITTLE CARE</span>
                <h2 class="minor-page-section-title">Because every bake deserves a safe journey.</h2>
                <p>Bakery products are delicate by nature. We take care during preparation, packing, and delivery so your order reaches 
                    you in the best condition possible.
                </p>
            </div>
        </section>


        <section class="minor-page-closing shipping-closing">
            <span class="minor-page-closing-eyebrow">NEED MORE HELP?</span>
            <h2>Have a question about delivery?</h2>
            <p>We're happy to help with questions about your order, delivery, or anything else you need to know.</p>
            <a href="/contact" class="minor-page-primary-button">
                Contact Us
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </section>

    </div>

</main>

<%- include("partials/footer.ejs") %>